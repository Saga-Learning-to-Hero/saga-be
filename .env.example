SPRING_PROFILES_ACTIVE=local

MYSQL_URL=jdbc:mysql://<HOST>:<PORT>/saga_dev?sslmode=require
MYSQL_USERNAME=
MYSQL_PASSWORD=

NEO4J_URI=neo4j+s://<HOST>
NEO4J_USERNAME=
NEO4J_PASSWORD=

REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=true

RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=
RABBITMQ_SSL_ENABLED=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SAGA_AUTH_FRONTEND_ORIGINS=http://localhost:3000
SAGA_AUTH_COOKIE_SECURE=false
SAGA_AUTH_COOKIE_SAME_SITE=Lax
SAGA_AUTH_GOOGLE_ALLOWED_HOSTED_DOMAINS=fpt.edu.vn,fe.edu.vn
SAGA_AUTH_GOOGLE_SUCCESS_URL=http://localhost:3000/dashboard
SAGA_AUTH_GOOGLE_PASSWORD_SETUP_URL=http://localhost:3000/auth/setup-password
SAGA_AUTH_GOOGLE_FAILURE_URL=http://localhost:3000/login

SAGA_BOOTSTRAP_ADMIN_ENABLED=true
SAGA_BOOTSTRAP_ADMIN_USERNAME=admin
SAGA_BOOTSTRAP_ADMIN_PASSWORD=<set-me>
SAGA_BOOTSTRAP_ADMIN_EMAIL=admin@saga.local

# Public URL used to build OAuth/webhook callbacks behind Railway/HTTPS proxy.
SAGA_PUBLIC_BASE_URL=http://localhost:8080
SAGA_INTEGRATION_SUCCESS_URL=http://localhost:3000/integrations/success
SAGA_INTEGRATION_FAILURE_URL=http://localhost:3000/integrations/failure
SAGA_INTEGRATION_TOKEN_ENCRYPTION_KEY=

# GitHub App (leave empty to keep GitHub integration disabled)
SAGA_GITHUB_ENABLED=false
SAGA_GITHUB_APP_ID=
SAGA_GITHUB_APP_SLUG=
SAGA_GITHUB_CLIENT_ID=
SAGA_GITHUB_CLIENT_SECRET=
SAGA_GITHUB_PRIVATE_KEY_BASE64=
SAGA_GITHUB_WEBHOOK_SECRET=
SAGA_GITHUB_OAUTH_CALLBACK_URL=http://localhost:8080/api/integrations/github/oauth/callback
SAGA_GITHUB_SETUP_CALLBACK_URL=http://localhost:8080/api/integrations/github/setup/callback

# Jira Cloud 3LO
SAGA_JIRA_ENABLED=false
SAGA_JIRA_CLIENT_ID=
SAGA_JIRA_CLIENT_SECRET=
SAGA_JIRA_OAUTH_CALLBACK_URL=http://localhost:8080/api/integrations/jira/oauth/callback
SAGA_JIRA_TEAM_OAUTH_CALLBACK_URL=http://localhost:8080/api/integrations/jira/team/callback
SAGA_JIRA_WEBHOOK_URL=http://localhost:8080/api/webhooks/jira
SAGA_JIRA_OAUTH_SCOPES=read:me,read:jira-user,read:jira-work,read:project:jira,read:issue-details:jira,read:jql:jira,read:board-scope:jira-software,read:sprint:jira-software,manage:jira-webhook,offline_access

# Attribution / step-up
SAGA_ATTRIBUTION_REAUTH_WINDOW_MINUTES=10
SAGA_ATTRIBUTION_IDENTITY_CHANGE_DEADLINE_WINDOW_HOURS=24

# WebAuthn / passkeys (off until RP domain is ready)
SAGA_WEBAUTHN_ENABLED=false
SAGA_WEBAUTHN_RP_ID=
SAGA_WEBAUTHN_RP_NAME=SAGA
SAGA_WEBAUTHN_ALLOWED_ORIGINS=
