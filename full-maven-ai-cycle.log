Hibernate: create table academic_class (created_at timestamp(6) not null, deleted_at timestamp(6), updated_at timestamp(6) not null, id char(36) not null, semester_id char(36), class_code varchar(64) not null, name varchar(255) not null, primary key (id), constraint uk_academic_class_semester_code unique (semester_id, class_code), constraint uk_academic_class_id_semester unique (id, semester_id))
Hibernate: create table active_semester_setting (singleton_id tinyint not null, updated_at timestamp(6) not null, semester_id char(36), updated_by_user_id char(36), primary key (singleton_id))
Hibernate: create table ai_academic_classification (confidence float(53), created_at timestamp(6) not null, reviewed_at timestamp(6), updated_at timestamp(6) not null, analysis_run_id char(36), artifact_id char(36), deliverable_id char(36), id char(36) not null, phase_id char(36), project_id char(36), source_classification_id char(36), syllabus_version_id char(36), ai_summary varchar(255), artifact_revision varchar(255), artifact_type enum ('COMMIT','COURSE','STUDENT','TASK','TEAM'), provenance enum ('AI','HUMAN'), status enum ('CONFIRMED','CORRECTED','PROPOSED','REJECTED'), target_type enum ('EXPECTED_DELIVERABLE','PHASE'), primary key (id))
Hibernate: create table ai_academic_classification_review (created_at timestamp(6) not null, updated_at timestamp(6) not null, classification_id char(36), corrected_deliverable_id char(36), corrected_phase_id char(36), id char(36) not null, reviewer_user_id char(36), reason varchar(255), action enum ('CONFIRM','CORRECT','REJECT'), corrected_target_type enum ('EXPECTED_DELIVERABLE','PHASE'), primary key (id))
Hibernate: create table ai_agent_conversation_scope (created_at timestamp(6) not null, updated_at timestamp(6) not null, conversation_id char(36) not null, course_id char(36) not null, id char(36) not null, owner_user_id char(36) not null, owner_application_role enum ('ADMIN','LECTURER','STUDENT') not null, primary key (id), constraint uk_ai_conversation_id unique (conversation_id))
Hibernate: create table ai_agent_delegation_context (created_at timestamp(6) not null, expires_at timestamp(6) not null, updated_at timestamp(6) not null, actor_user_id char(36) not null, conversation_id char(36) not null, course_id char(36), id char(36) not null, token_hash varchar(64) not null, capabilities varchar(128) not null, actor_application_role enum ('ADMIN','LECTURER','STUDENT') not null, primary key (id), constraint uk_ai_delegation_token unique (token_hash))
