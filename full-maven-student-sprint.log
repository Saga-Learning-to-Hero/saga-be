Hibernate: create table ai_analysis_evidence (ordinal_index integer not null, created_at timestamp(6) not null, updated_at timestamp(6) not null, analysis_run_id char(36) not null, id char(36) not null, content_hash varchar(64) not null, source_ref varchar(512) not null, metadata_json MEDIUMTEXT, payload_json MEDIUMTEXT, evidence_type enum ('CHANGED_FILE_MANIFEST','CI_RESULT','CODE_RANGE','COMMIT_MESSAGE','DIFF_HUNK','EXCLUSION_MANIFEST','HUMAN_CONFIRMED_EXAMPLE','METADATA','PROVIDER_EVIDENCE_STATUS','SYLLABUS_DELIVERABLE','SYLLABUS_NODE','SYLLABUS_PHASE','SYLLABUS_VERSION','TASK_FIELD','TEST_RESULT') not null, primary key (id), constraint uk_ai_analysis_evidence_run_ordinal unique (analysis_run_id, ordinal_index))
